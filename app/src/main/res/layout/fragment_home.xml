<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="@dimen/elevation_none">

        <!-- HEADER TOOLBAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingVertical="@dimen/spacing_md">

            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu"
                app:tint="?attr/colorOnBackground"
                android:stateListAnimator="@animator/scale_press" />

            <TextView
                style="?attr/textAppearanceHeadlineMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Sổ Thu Chi" />

            <ImageView
                android:id="@+id/ivSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_search_vector"
                app:tint="?attr/colorOnBackground"
                android:stateListAnimator="@animator/scale_press" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:clipToPadding="false"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- SUMMARY CARD (GRADIENT) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_lg"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/summaryLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_gradient_primary"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_xl">

                    <!-- Month Filter -->
                    <LinearLayout
                        android:id="@+id/llMonthFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/spacing_sm"
                        android:stateListAnimator="@animator/scale_press">

                        <TextView
                            android:id="@+id/tvFilterMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tháng 05"
                            android:textColor="@color/text_on_gradient"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFilterYear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="2026"
                            android:textColor="@color/text_on_gradient_secondary"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/ivCalendar"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/text_on_gradient" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="Tổng số dư"
                        android:textColor="@color/text_on_gradient_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="0 đ"
                        android:textColor="@color/text_on_gradient"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMaxTextSize="36sp"
                        app:autoSizeMinTextSize="24sp"
                        android:maxLines="1"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tổng thu"
                                android:textColor="@color/text_on_gradient_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvTotalIncome"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="+0 đ"
                                android:textColor="@color/color_income_light"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tổng chi"
                                android:textColor="@color/text_on_gradient_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvTotalExpense"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:text="-0 đ"
                                android:textColor="@color/color_expense_light"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SMART ENTRY CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/smartEntryCard"
                style="?attr/materialCardViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardCornerRadius="@dimen/radius_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/spacing_sm">

                    <EditText
                        android:id="@+id/etSmartInput"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Ví dụ: Ăn sáng 30k"
                        android:inputType="text"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="@color/text_hint"
                        android:textSize="16sp" />

                    <ImageButton
                        android:id="@+id/btnSmartSend"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/shape_circle_icon"
                        android:backgroundTint="?attr/colorPrimary"
                        android:src="@android:drawable/ic_menu_send"
                        app:tint="@color/text_on_gradient"
                        android:stateListAnimator="@animator/scale_press" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RECENT TRANSACTIONS HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_md">

                <TextView
                    style="?attr/textAppearanceTitleMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Giao dịch gần đây" />
                    
                <TextView
                    style="?attr/textAppearanceLabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:text="Xem tất cả" />
            </LinearLayout>

            <!-- EMPTY STATE -->
            <LinearLayout
                android:id="@+id/emptyStateLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxxl"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/ic_document"
                    app:tint="?attr/colorSurfaceVariant" />

                <TextView
                    style="?attr/textAppearanceBodyLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="Chưa có giao dịch nào"
                    android:textColor="@color/text_hint" />

                <TextView
                    style="?attr/textAppearanceBodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Nhập hoặc dùng AI để thêm giao dịch" />
            </LinearLayout>

            <!-- TRANSACTIONS RECYCLERVIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layoutAnimation="@anim/layout_animation_fall_down"
                tools:listitem="@layout/item_transaction" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FLOATING AI CHAT BUTTON -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAiChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="16dp"
        android:layout_marginBottom="90dp"
        android:contentDescription="Chat với AI"
        app:backgroundTint="?attr/colorTertiary"
        app:tint="@color/text_on_gradient"
        app:borderWidth="0dp"
        app:srcCompat="@drawable/ic_launcher_foreground"
        app:elevation="@dimen/elevation_lg" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>