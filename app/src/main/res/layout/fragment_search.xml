<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="@dimen/elevation_none">

        <!-- SEARCH BAR CONTAINER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingVertical="@dimen/spacing_md">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/colorOnSurface"
                android:stateListAnimator="@animator/scale_press" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_md"
                app:cardBackgroundColor="@color/input_bg"
                app:cardCornerRadius="@dimen/radius_full"
                app:cardElevation="@dimen/elevation_none"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search_vector"
                        app:tint="@color/icon_default" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:background="@null"
                        android:hint="Tìm kiếm giao dịch..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="@color/text_hint"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/ivClear"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="@color/icon_default"
                        android:visibility="gone"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- CHIP SUGGESTIONS -->
    <HorizontalScrollView
        android:id="@+id/layoutSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingVertical="@dimen/spacing_md"
        android:paddingHorizontal="@dimen/spacing_md"
        android:background="?attr/colorSurface"
        android:elevation="@dimen/elevation_sm"
        android:clipToPadding="false">

        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFood"
                style="?attr/chipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ăn uống" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipShopping"
                style="?attr/chipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mua sắm" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTravel"
                style="?attr/chipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Di chuyển" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipIncome"
                style="?attr/chipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thu nhập"
                app:chipBackgroundColor="@color/color_income_light"
                android:textColor="@color/color_income_dark"/>
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_search_vector"
            app:tint="?attr/colorSurfaceVariant" />

        <TextView
            style="?attr/textAppearanceBodyLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Không tìm thấy kết quả"
            android:textColor="@color/text_hint" />
    </LinearLayout>

    <!-- SEARCH RESULTS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="@dimen/spacing_lg"
        android:layoutAnimation="@anim/layout_animation_fall_down"
        tools:listitem="@layout/item_transaction" />

</LinearLayout>