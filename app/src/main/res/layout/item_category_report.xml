<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    style="?attr/materialCardViewStyle"
    android:stateListAnimator="@animator/scale_press">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg">

        <View
            android:id="@+id/viewCategoryColor"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/shape_circle_icon"
            android:backgroundTint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tvCategoryName"
            style="?attr/textAppearanceTitleMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            tools:text="Ăn uống" />

        <TextView
            android:id="@+id/tvCategoryPercent"
            style="?attr/textAppearanceLabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_pill_badge"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_xs"
            android:textColor="?attr/colorPrimary"
            tools:text="45%" />

        <TextView
            android:id="@+id/tvCategoryAmount"
            style="?attr/textAppearanceTitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            tools:text="2,500,000 đ" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>