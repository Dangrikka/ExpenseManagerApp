<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <action
        android:id="@+id/action_global_searchFragment"
        app:destination="@id/searchFragment"
        app:enterAnim="@anim/nav_default_enter_anim"
        app:exitAnim="@anim/nav_default_exit_anim" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.expensemanager.ui.home.HomeFragment"
        android:label="Trang chủ"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_addTransactionFragment"
            app:destination="@id/addTransactionFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim" />

        <action
            android:id="@+id/action_homeFragment_to_transactionDetailFragment"
            app:destination="@id/transactionDetailFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim" />

        <action
            android:id="@+id/action_homeFragment_to_reportFragment"
            app:destination="@id/reportFragment" />
        <action
            android:id="@+id/action_homeFragment_to_statsFragment"
            app:destination="@id/statsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:popUpTo="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/statsFragment"
        android:name="com.example.expensemanager.ui.stats.StatsFragment"
        android:label="Thống kê"
        tools:layout="@layout/fragment_stats" />

    <fragment
        android:id="@+id/addTransactionFragment"
        android:name="com.example.expensemanager.ui.add.AddTransactionFragment"
        android:label="Thêm giao dịch"
        tools:layout="@layout/fragment_add_transaction" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.expensemanager.ui.search.SearchFragment"
        android:label="Tìm kiếm"
        tools:layout="@layout/fragment_search" >

        <action
            android:id="@+id/action_global_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>

    <fragment
        android:id="@+id/reportFragment"
        android:name="com.example.expensemanager.ui.report.ReportFragment"
        android:label="Báo cáo"
        tools:layout="@layout/fragment_report" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.expensemanager.ui.profile.ProfileFragment"
        android:label="Tôi"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim" />
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_profileFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/transactionDetailFragment"
        android:name="com.example.expensemanager.ui.detail.TransactionDetailFragment"
        android:label="Chi tiết giao dịch"
        tools:layout="@layout/fragment_transaction_detail">

        <action
            android:id="@+id/action_transactionDetailFragment_to_addTransactionFragment"
            app:destination="@id/addTransactionFragment" />

    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.expensemanager.ui.settings.SettingsFragment"
        android:label="Cài đặt"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.expensemanager.ui.auth.LoginFragment"
        android:label="Đăng nhập"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.expensemanager.ui.auth.RegisterFragment"
        android:label="Đăng ký"
        tools:layout="@layout/fragment_register" >
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

</navigation>